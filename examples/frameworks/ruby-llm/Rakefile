# Separate processes: SDK/patch state must not leak into the paused integration test.
TEST_FILES = %w[test/test_recipe.rb test/test_optin.rb test/test_wire.rb test/test_paused.rb].freeze

desc "Run every test file in its own process"
task :test do
  TEST_FILES.each { |f| sh "ruby", "-I", "test", "-I", ".", f }
end

task default: :test
