source "https://rubygems.org"

ruby ">= 3.2"

# Tested pair. ruby_llm 2.x is NOT supported by opentelemetry-instrumentation-ruby_llm 0.7.1:
# on 2.0.0 and 2.1.1 the first chat.ask raises NoMethodError inside the patched Chat#complete.
# Override with RUBY_LLM_VERSION=1.15.0 to run the older leg, or 2.1.1 to reproduce the failure.
gem "ruby_llm", ENV.fetch("RUBY_LLM_VERSION", "1.16.0")
gem "opentelemetry-instrumentation-ruby_llm", "0.7.1"
gem "opentelemetry-sdk"
gem "opentelemetry-exporter-otlp"

group :test do
  gem "minitest", "~> 5.25"
  gem "webmock", "~> 3.25"
  gem "rake"
end
