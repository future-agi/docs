{
  "name": "flue-futureagi-example",
  "private": true,
  "type": "module",
  "description": "A Flue agent that exports its OpenTelemetry traces to Future AGI.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node dist/server.mjs",
    "agent": "flue run src/agents/weather.ts",
    "test": "node --test test/*.test.ts",
    "test:flue": "node --test test/flue-run.e2e.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@flue/cli": "2.3.0",
    "@flue/opentelemetry": "2.3.0",
    "@flue/runtime": "2.3.0",
    "@flue/vite": "2.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "hono": "4.13.13",
    "valibot": "1.5.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
