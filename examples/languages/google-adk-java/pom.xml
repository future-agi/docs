<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ai.futureagi.examples</groupId>
  <artifactId>google-adk-java-tracing</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The ADK version under test. Override with -Dadk.version=... to run another release. -->
    <adk.version>1.12.0</adk.version>
    <langchain4j.version>1.12.2</langchain4j.version>
  </properties>

  <dependencies>
    <!-- The only Future AGI-relevant dependency: ADK itself. It already brings
         opentelemetry-api, opentelemetry-sdk and opentelemetry-exporter-otlp (1.51.0 in ADK 1.12.0). -->
    <dependency>
      <groupId>com.google.adk</groupId>
      <artifactId>google-adk</artifactId>
      <version>${adk.version}</version>
    </dependency>
    <!-- Only so this example can call any OpenAI-compatible endpoint. Use your own model wiring. -->
    <dependency>
      <groupId>com.google.adk</groupId>
      <artifactId>google-adk-langchain4j</artifactId>
      <version>${adk.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>ai.futureagi.examples.adk.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
