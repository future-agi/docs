// The Worker as you would deploy it: the real Workers AI binding. This file is shown for the shape only.
// This example never runs `wrangler deploy`, and `wrangler dev` with a real `ai` binding needs a Cloudflare login.
{
  "name": "fi-workers-ai-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "ai": { "binding": "AI" },
  "vars": { "FI_BASE_URL": "https://api.futureagi.com", "FI_PROJECT_NAME": "my-workers-ai-app" }
  // Secrets, never in this file:  wrangler secret put FI_API_KEY   and   wrangler secret put FI_SECRET_KEY
}
