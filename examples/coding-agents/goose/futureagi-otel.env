# Source this file before starting goose: `source futureagi-otel.env`
# goose reads these standard OpenTelemetry variables at startup and exports
# its own session, model-call, and tool-call spans over OTLP/HTTP.
#
# goose sends to the local OpenTelemetry Collector started with
# otel-collector.yaml. The collector removes the OS user name and host name
# goose attaches to every export, then forwards to Future AGI with your keys,
# so no Future AGI credential is set here.

# The signal-specific endpoint is the full URL; goose does not append
# /v1/traces to it. Match GOOSE_OTLP_LISTEN if you changed it.
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://127.0.0.1:4318/v1/traces"
export OTEL_TRACES_EXPORTER="otlp"
# Future AGI accepts traces only.
export OTEL_METRICS_EXPORTER="none"
export OTEL_LOGS_EXPORTER="none"

# Content stays off: goose exports no prompts, responses, tool arguments, or
# tool results unless this is exactly "true". Leave it unset for the default.
# export OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="true"
