{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor sessionStart 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor beforeSubmitPrompt 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor postToolUse 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor postToolUseFailure 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor subagentStop 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "afterAgentThought": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor afterAgentThought 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor afterAgentResponse 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor preCompact 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor stop 2>/dev/null || true",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 -B ./hooks/fi-hook-to-otlp/emit.py cursor sessionEnd 2>/dev/null || true",
        "timeout": 10
      }
    ]
  }
}
