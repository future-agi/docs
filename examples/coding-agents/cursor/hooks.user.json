{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor sessionStart",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor beforeSubmitPrompt",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor postToolUse",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor postToolUseFailure",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor subagentStop",
        "timeout": 10
      }
    ],
    "afterAgentThought": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor afterAgentThought",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor afterAgentResponse",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor preCompact",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor stop",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 ./hooks/fi-hook-to-otlp/emit.py cursor sessionEnd",
        "timeout": 10
      }
    ]
  }
}
