# GitHub Copilot (CLI and VS Code Copilot Chat) -> Future AGI traces.
# Source this file in the shell that starts `copilot`, or in the shell you
# launch VS Code from. Keys come from your environment; never commit them.

# Future AGI OTLP/HTTP base URL. Copilot appends /v1/traces itself.
# Self-hosted: point this at your collector, for example http://localhost:14338
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.futureagi.com/tracer"

# Future AGI project keys, sent as OTLP headers.
export OTEL_EXPORTER_OTLP_HEADERS="X-Api-Key=${FI_API_KEY},X-Secret-Key=${FI_SECRET_KEY}"

# Future AGI files the traces under this project (created on first export).
export OTEL_RESOURCE_ATTRIBUTES="project_name=my-copilot-sessions,project_type=observe"

# Content capture is OFF by default. Opt in only in a trusted environment:
#   Copilot CLI:      export OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
#   VS Code Copilot:  export COPILOT_OTEL_CAPTURE_CONTENT=true
