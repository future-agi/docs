{
  "fi-hook-to-otlp": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity PreInvocation",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity PostInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 fi-hook-to-otlp/emit.py antigravity PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 fi-hook-to-otlp/emit.py antigravity PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity Stop",
        "timeout": 10
      }
    ]
  }
}
