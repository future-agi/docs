{
  "fi-hook-to-otlp": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity SessionStart || true",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity PreInvocation || true",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity PostInvocation || true",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 fi-hook-to-otlp/emit.py antigravity PostToolUse || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 fi-hook-to-otlp/emit.py antigravity Stop || true",
        "timeout": 10
      }
    ]
  }
}
