{
  "fi-hook-to-otlp": {
    "SessionStart": [
      {
        "type": "command",
        "command": "(python3 -B fi-hook-to-otlp/emit.py antigravity SessionStart 2>/dev/null || true)",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "(python3 -B fi-hook-to-otlp/emit.py antigravity PreInvocation 2>/dev/null || true)",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "(python3 -B fi-hook-to-otlp/emit.py antigravity PostInvocation 2>/dev/null || true)",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "(python3 -B fi-hook-to-otlp/emit.py antigravity PostToolUse 2>/dev/null || true)",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "(python3 -B fi-hook-to-otlp/emit.py antigravity Stop 2>/dev/null || true)",
        "timeout": 10
      }
    ]
  }
}
