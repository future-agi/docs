// Send OpenClaw agent traces to Future AGI with the official diagnostics-otel plugin.
//
//   openclaw plugins install clawhub:@openclaw/diagnostics-otel
//   openclaw config patch --file futureagi.patch.json5
//
// `plugins install` enables the plugin, so this patch has no `plugins` block.
// Do not add a `plugins.allow` list for this: it is an exclusive allowlist and
// disables every plugin not on it.
//
// Keys come from the environment (~/.openclaw/.env works, see env.example).
// For a self-hosted Future AGI, replace the host in tracesEndpoint.
{
  env: {
    vars: {
      // Only the env resource detector. Without it OpenClaw also exports the
      // host name, host id, OS user name, executable path and the full command
      // line (which holds the prompt for `openclaw agent --local -m "..."`).
      // Non-overriding: a value already in the process environment wins.
      OTEL_NODE_RESOURCE_DETECTORS: "env",
    },
  },
  diagnostics: {
    enabled: true,
    otel: {
      enabled: true,
      // Exact URL: OpenClaw does not append a path to tracesEndpoint.
      tracesEndpoint: "https://api.futureagi.com/tracer/v1/traces",
      protocol: "http/protobuf",
      headers: {
        "X-Api-Key": "${FI_API_KEY}",
        "X-Secret-Key": "${FI_SECRET_KEY}",
      },
      serviceName: "openclaw",
      traces: true,
      // Future AGI ingests traces only.
      metrics: false,
      logs: false,
      // Default. true exports prompts, responses, tool inputs/outputs and tool definitions.
      captureContent: false,
    },
  },
}
