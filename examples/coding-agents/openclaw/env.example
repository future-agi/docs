# Append to ~/.openclaw/.env (or $OPENCLAW_STATE_DIR/.env). OpenClaw loads it at
# start without overriding variables that are already set.
FI_API_KEY=your-futureagi-api-key
FI_SECRET_KEY=your-futureagi-secret-key
# The Future AGI project the traces land in.
OTEL_RESOURCE_ATTRIBUTES=project_name=openclaw
# OTEL_NODE_RESOURCE_DETECTORS=env comes from futureagi.patch.json5 (config env
# block). If you set OTEL_NODE_RESOURCE_DETECTORS here or in the Gateway's
# environment, that value wins: keep it `env`, otherwise OpenClaw exports the
# host name, OS user name, executable paths and the command line (which holds
# the prompt for `openclaw agent --local -m "..."`).
