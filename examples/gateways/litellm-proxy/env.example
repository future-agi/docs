# Environment for LiteLLM Proxy -> Future AGI (OTEL v2). Copy to .env, fill in, then:
#   docker run --env-file .env -v "$PWD/config.yaml:/app/config.yaml:ro" -p 4000:4000 \
#     ghcr.io/berriai/litellm:v1.105.1 --config /app/config.yaml --port 4000
# (an --env-file takes values literally: do not quote them)

# 1. Turn on the proxy's OpenTelemetry v2 tracing (config.yaml also lists the "otel" callback)
LITELLM_OTEL_V2=true

# 2. Where to send it: OTLP/HTTP to your Future AGI traces endpoint.
#    Self-hosted:  http://<your-collector-host>:4318/v1/traces
#    Cloud:        https://api.futureagi.com/tracer/v1/traces   (not exercised in this repo's tests)
OTEL_EXPORTER=otlp_http
OTEL_ENDPOINT=http://localhost:4318/v1/traces

# 3. Future AGI keys, as two headers. No Bearer. No spaces. Keys must not contain "," .
OTEL_HEADERS=X-Api-Key=YOUR_API_KEY,X-Secret-Key=YOUR_SECRET_KEY

# 4. The Observe project. Required: a batch without project_name is rejected (HTTP 400).
OTEL_RESOURCE_ATTRIBUTES=project_name=litellm-proxy,project_type=observe

# 5. Prompts and responses stay out of the trace unless you change this to SPAN_ONLY.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Your own proxy settings (the demo config.yaml reads these)
LITELLM_MASTER_KEY=sk-change-me
UPSTREAM_MODEL=openai/gpt-4o-mini
UPSTREAM_API_BASE=https://api.openai.com/v1
UPSTREAM_API_KEY=YOUR_PROVIDER_KEY
