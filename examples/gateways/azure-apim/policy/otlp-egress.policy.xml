<!--
  Azure API Management policy for an "OTLP traces egress" API that forwards to Future AGI.
  NOT RUN AGAINST AZURE. Written from the Microsoft Learn policy reference (set-backend-service,
  rewrite-uri, set-header); examples/gateways/azure-apim/apim_standin.py models its behaviour locally.

  Create the API with URL suffix `tracer` and ONE operation: POST /v1/traces.
  Create two secret named values: fi-api-key, fi-secret-key (Key Vault references are best).
  Hosted Future AGI base-url: https://api.futureagi.com   Self-hosted: your collector, e.g. https://otel.example.com
-->
<policies>
  <inbound>
    <base />
    <!-- Future AGI -->
    <set-backend-service base-url="https://api.futureagi.com" />
    <rewrite-uri template="/tracer/v1/traces" copy-unmatched-params="false" />
    <set-header name="X-Api-Key" exists-action="override">
      <value>{{fi-api-key}}</value>
    </set-header>
    <set-header name="X-Secret-Key" exists-action="override">
      <value>{{fi-secret-key}}</value>
    </set-header>
    <!-- The caller's APIM subscription key and any Authorization header are for APIM, not for Future AGI. -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
