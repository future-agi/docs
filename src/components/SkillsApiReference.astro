---
import contract from '../../public/api/skills-sealed.json';
const methods = new Set(['get', 'post', 'put', 'patch', 'delete', 'head', 'options']);
const definitions = contract.definitions as Record<string, any>;
const schemaId = (name: string) => `schema-${name.toLowerCase()}`;
const refName = (schema: any) => schema?.$ref?.split('/').at(-1);
const label = (schema: any): string => {
  if (!schema) return 'No schema declared';
  if (schema.$ref) return refName(schema);
  if (schema.type === 'array') return `array of ${label(schema.items)}`;
  return schema.type ?? (schema.properties ? 'object' : 'See raw contract');
};
const operations = Object.entries(contract.paths).flatMap(([route, item]) =>
  Object.entries(item).filter(([method]) => methods.has(method)).map(([method, op]) => {
    const operation = op as any;
    const parameters = new Map<string, any>();
    for (const param of [...((item as any).parameters ?? []), ...(operation.parameters ?? [])]) {
      parameters.set(`${param.in}:${param.name}`, param);
    }
    return { route, method, operation, parameters: [...parameters.values()] };
  }));
---
<p><strong>{operations.length} operations</strong> across {Object.keys(contract.paths).length} paths. Each entry below is generated from the sealed contract, not a captured HTTP response.</p>
{operations.map(({ route, method, operation, parameters }) => (
  <section class="api-operation" id={operation.operationId}>
    <h3><code>{method.toUpperCase()} {route}</code></h3>
    {operation.description && <p>{operation.description}</p>}
    <p><small>Operation ID: <code>{operation.operationId}</code></small></p>
    {parameters.length ? <div class="api-table"><table>
      <thead><tr><th>Parameter</th><th>Location</th><th>Required</th><th>Type / schema</th><th>Constraints</th></tr></thead>
      <tbody>{parameters.map(p => <tr>
        <td><code>{p.name}</code></td><td>{p.in}</td><td>{p.required ? 'Yes' : 'No'}</td>
        <td>{refName(p.schema) ? <a href={`#${schemaId(refName(p.schema))}`}>{label(p.schema)}</a> : label(p.schema ?? p)}</td>
        <td>{p.description ?? ''}{p.enum ? ` Allowed: ${JSON.stringify(p.enum)}.` : ''}{p.default !== undefined ? ` Default: ${JSON.stringify(p.default)}.` : ''}{p.minimum !== undefined ? ` Min: ${p.minimum}.` : ''}{p.maximum !== undefined ? ` Max: ${p.maximum}.` : ''}{p.format ? ` Format: ${p.format}.` : ''}</td>
      </tr>)}</tbody>
    </table></div> : <p>No operation-specific parameters are declared. Authentication and tenant scope still apply.</p>}
    <div class="api-table"><table>
      <thead><tr><th>HTTP status</th><th>Response schema</th><th>Description</th></tr></thead>
      <tbody>{Object.entries(operation.responses ?? {}).map(([status, value]) => {
        const response = value as any;
        return <tr><td><code>{status}</code></td><td>{refName(response.schema) ? <a href={`#${schemaId(refName(response.schema))}`}>{label(response.schema)}</a> : label(response.schema)}</td><td>{response.description || 'No additional description declared.'}</td></tr>;
      })}</tbody>
    </table></div>
    <details><summary>Exact operation contract (not a response example)</summary><pre><code>{JSON.stringify(operation, null, 2)}</code></pre></details>
  </section>
))}
<h2 id="schemas">Request and response schemas</h2>
<p>Definitions preserve required fields, enums, nested references, and bounds from Swagger. A permissive object definition does not establish undocumented application semantics. The downloadable contract includes every referenced definition.</p>
{Object.entries(definitions).map(([name, schema]) => (
  <section id={schemaId(name)} class="api-schema">
    <h3>{name}</h3>
    {schema.description && <p>{schema.description}</p>}
    {schema.properties && <div class="api-table"><table>
      <thead><tr><th>Field</th><th>Required</th><th>Type</th><th>Description</th></tr></thead>
      <tbody>{Object.entries(schema.properties).map(([field, value]) => {
        const property = value as any;
        return <tr><td><code>{field}</code></td><td>{schema.required?.includes(field) ? 'Yes' : 'No'}</td><td>{refName(property) ? <a href={`#${schemaId(refName(property))}`}>{label(property)}</a> : label(property)}</td><td>{property.description ?? ''}{property.enum ? ` Allowed: ${JSON.stringify(property.enum)}.` : ''}</td></tr>;
      })}</tbody>
    </table></div>}
    <details><summary>Exact schema including nested constraints</summary><pre><code>{JSON.stringify(schema, null, 2)}</code></pre></details>
  </section>
))}
<style>
  .api-operation, .api-schema { margin-block: 2.5rem; scroll-margin-top: 6rem; }
  h3 code { white-space: normal; overflow-wrap: anywhere; }
  .api-table { overflow-x: auto; max-width: 100%; }
  td { vertical-align: top; overflow-wrap: anywhere; }
  pre { overflow-x: auto; max-width: 100%; }
  summary { cursor: pointer; }
</style>
