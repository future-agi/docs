---
import { topNav } from '../lib/navigation';
interface Props { activeHref?: string }
const { activeHref } = Astro.props;
const linkStyle = 'block w-full text-left px-3 py-2 rounded-md text-sm text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-hover)] hover:text-[var(--color-text-primary)]';
---
<nav class="lg:hidden p-2" aria-label="Documentation tabs">
  {topNav.map(tab => (
    <a href={tab.href} aria-current={tab.href === activeHref ? 'location' : undefined}
      class:list={[linkStyle, 'aria-[current=location]:bg-[var(--color-bg-hover)] aria-[current=location]:font-medium']}>
      {tab.title}
    </a>
  ))}
  <div class="mt-2 pt-2 border-t border-[var(--color-border-subtle)]">
    <button type="button" class={linkStyle} data-mobile-action="search-button">Search docs</button>
    <button type="button" class={linkStyle} data-mobile-action="ask-ai-button">Ask AI</button>
    <a class={linkStyle} href="https://meetings.hubspot.com/salil-kolhe/help-futureagi-app" target="_blank" rel="noopener noreferrer">Request demo</a>
    <a class={linkStyle} href="https://app.futureagi.com">Dashboard</a>
  </div>
</nav>

<script>
  // Delegate because FastNav replaces the contents of the drawer on navigation.
  document.addEventListener('click', event => {
    const button = event.target instanceof Element && event.target.closest<HTMLButtonElement>('button[data-mobile-action]');
    if (button && button.dataset.mobileAction) document.getElementById(button.dataset.mobileAction)?.click();
  });
</script>
