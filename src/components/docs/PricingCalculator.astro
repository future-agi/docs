---
/**
 * PricingCalculator — interactive estimate of a monthly Future AGI bill.
 *
 * Usage in MDX (no import line, the component is in COMPONENT_MAP):
 *   <PricingCalculator />
 *   <PricingCalculator plan="boost" interval="annual" />
 *
 * Pattern follows ApiPlayground.astro: a plain .astro component with no React
 * and no hydration directive, static markup carrying data-* attributes, and one
 * `is:inline` script for the client-side behaviour.
 *
 * Both the <style> and the <script> are `is:inline` on purpose. The custom
 * FastNav swaps the <article> innerHTML and re-executes the scripts it finds
 * there, but it never touches <head>. A hoisted style tag would therefore be
 * missing when the page is reached by client-side navigation, so the CSS stays
 * in the body next to the markup. Every selector is prefixed `.pcalc-`.
 */
interface Props {
  plan?: 'free' | 'payg' | 'boost' | 'scale' | 'enterprise';
  interval?: 'monthly' | 'annual';
}

const { plan = 'payg', interval = 'monthly' } = Astro.props;

const pid = `pcalc-${Math.random().toString(36).slice(2, 8)}`;

/** Meters, in the order they are billed. `def` is the free allowance. */
const METERS = [
  { key: 'storage', label: 'Storage', unit: 'GB', def: 50, max: 5000 },
  { key: 'ai_credits', label: 'AI credits', unit: 'credits', def: 2000, max: 200000 },
  { key: 'gateway_requests', label: 'Gateway requests', unit: 'requests', def: 100000, max: 200000000 },
  { key: 'gateway_cache_hits', label: 'Gateway cache hits', unit: 'hits', def: 100000, max: 20000000 },
  { key: 'text_sim_tokens', label: 'Text simulation tokens', unit: 'tokens', def: 1000000, max: 200000000 },
  { key: 'voice_sim_minutes', label: 'Voice simulation minutes', unit: 'minutes', def: 60, max: 20000 },
  { key: 'tracing_events', label: 'Tracing events', unit: 'events', def: 50000, max: 200000000 },
];

/**
 * Graduated tier ladders, shared by every plan. `upTo` is cumulative usage in
 * the period; `null` means the last, open-ended band.
 */
const TIERS: Record<string, { upTo: number | null; rate: number }[]> = {
  storage: [
    { upTo: 50, rate: 0 },
    { upTo: 500, rate: 2.0 },
    { upTo: 2048, rate: 1.5 },
    { upTo: null, rate: 1.0 },
  ],
  ai_credits: [
    { upTo: 2000, rate: 0 },
    { upTo: null, rate: 0.01 },
  ],
  gateway_requests: [
    { upTo: 100000, rate: 0 },
    { upTo: 1000000, rate: 0.00005 },
    { upTo: 10000000, rate: 0.00004 },
    { upTo: 100000000, rate: 0.000025 },
    { upTo: null, rate: 0.000015 },
  ],
  gateway_cache_hits: [
    { upTo: 100000, rate: 0 },
    { upTo: 1000000, rate: 0.00001 },
    { upTo: 10000000, rate: 0.0000075 },
    { upTo: null, rate: 0.000005 },
  ],
  text_sim_tokens: [
    { upTo: 1000000, rate: 0 },
    { upTo: 10000000, rate: 0.000002 },
    { upTo: 100000000, rate: 0.0000015 },
    { upTo: null, rate: 0.000001 },
  ],
  voice_sim_minutes: [
    { upTo: 60, rate: 0 },
    { upTo: 1000, rate: 0.08 },
    { upTo: 10000, rate: 0.06 },
    { upTo: null, rate: 0.04 },
  ],
  tracing_events: [
    { upTo: 50000, rate: 0 },
    { upTo: 1000000, rate: 0.00008 },
    { upTo: 10000000, rate: 0.00006 },
    { upTo: 100000000, rate: 0.00004 },
    { upTo: null, rate: 0.000025 },
  ],
};

/** Platform fees. `hardCap` blocks usage above the allowance instead of billing it. */
const PLANS = [
  { id: 'free', label: 'Free', monthly: 0, annual: 0, hardCap: true },
  { id: 'payg', label: 'Pay-as-you-go', monthly: 0, annual: 0, hardCap: false },
  { id: 'boost', label: 'Boost', monthly: 250.0, annual: 2700, hardCap: false },
  { id: 'scale', label: 'Scale', monthly: 750.0, annual: 7200, hardCap: false },
  { id: 'enterprise', label: 'Enterprise', monthly: 2000.0, annual: 19200, hardCap: false },
];

const INTERVALS = [
  { id: 'monthly', label: 'Monthly' },
  { id: 'annual', label: 'Annual' },
];
---

<div class="pcalc" id={pid} data-plan={plan} data-interval={interval}>

  <div class="pcalc-controls">
    <fieldset class="pcalc-fieldset">
      <legend class="pcalc-legend">Plan</legend>
      <div class="pcalc-segments">
        {PLANS.map((p) => (
          <Fragment>
            <input
              type="radio"
              class="pcalc-radio"
              name={`${pid}-plan`}
              id={`${pid}-plan-${p.id}`}
              value={p.id}
              checked={p.id === plan}
            />
            <label class="pcalc-segment" for={`${pid}-plan-${p.id}`}>{p.label}</label>
          </Fragment>
        ))}
      </div>
    </fieldset>

    <fieldset class="pcalc-fieldset" id={`${pid}-interval-set`}>
      <legend class="pcalc-legend">Billing interval</legend>
      <div class="pcalc-segments">
        {INTERVALS.map((i) => (
          <Fragment>
            <input
              type="radio"
              class="pcalc-radio"
              name={`${pid}-interval`}
              id={`${pid}-interval-${i.id}`}
              value={i.id}
              checked={i.id === interval}
            />
            <label class="pcalc-segment" for={`${pid}-interval-${i.id}`}>{i.label}</label>
          </Fragment>
        ))}
      </div>
      <p class="pcalc-hint" id={`${pid}-interval-hint`}></p>
    </fieldset>
  </div>

  <div class="pcalc-meters">
    {METERS.map((m) => (
      <div class="pcalc-meter">
        <label class="pcalc-meter-label" for={`${pid}-${m.key}`}>{m.label}</label>
        <div class="pcalc-meter-input">
          <input
            type="text"
            class="pcalc-num"
            id={`${pid}-${m.key}`}
            data-meter={m.key}
            inputmode="numeric"
            autocomplete="off"
            spellcheck="false"
            value={m.def.toLocaleString('en-US')}
          />
          <span class="pcalc-unit">{m.unit}</span>
        </div>
        <input
          type="range"
          class="pcalc-range"
          data-range={m.key}
          min="0"
          max="1000"
          step="1"
          value="0"
          aria-label={`${m.label} slider`}
        />
        <div class="pcalc-meter-foot">
          <span>{m.def.toLocaleString('en-US')} {m.unit} included free</span>
          <span class="pcalc-meter-max">slider max {m.max.toLocaleString('en-US')}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="pcalc-table-wrap">
    <table class="pcalc-table">
      <thead>
        <tr>
          <th scope="col">Meter</th>
          <th scope="col" class="pcalc-right">Usage</th>
          <th scope="col" class="pcalc-right">Included free</th>
          <th scope="col" class="pcalc-right">Billable</th>
          <th scope="col" class="pcalc-right">Cost</th>
        </tr>
      </thead>
      <tbody id={`${pid}-rows`}></tbody>
    </table>
  </div>

  <p class="pcalc-blocked-note" id={`${pid}-blocked-note`} hidden>
    Free is hard-capped, so usage stops once an allowance runs out. Pay-as-you-go keeps the same allowances and bills anything past them on the ladder above.
  </p>

  <div class="pcalc-totals" id={`${pid}-totals`}></div>

  <p class="pcalc-footnote">Estimate only. Excludes tax and any credits on your account.</p>
</div>

<script is:inline define:vars={{ pid, METERS, TIERS, PLANS }}>
(function () {
  var root = document.getElementById(pid);
  if (!root || root.getAttribute('data-pcalc-ready') === '1') return;
  root.setAttribute('data-pcalc-ready', '1');

  var rowsEl = document.getElementById(pid + '-rows');
  var totalsEl = document.getElementById(pid + '-totals');
  var noteEl = document.getElementById(pid + '-blocked-note');
  var intervalSet = document.getElementById(pid + '-interval-set');
  var intervalHint = document.getElementById(pid + '-interval-hint');
  if (!rowsEl || !totalsEl) return;

  var values = {};
  var expanded = {};
  METERS.forEach(function (m) { values[m.key] = m.def; });

  /* ---------- formatting ---------- */

  function fmtInt(n) {
    return Math.round(n).toLocaleString('en-US');
  }

  function fmtMoney(n) {
    var v = Math.round((n + Number.EPSILON) * 100) / 100;
    if (Object.is(v, -0)) v = 0;
    return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /* Band rates keep full precision: $0.0000075 must not round away to $0.00. */
  function fmtRate(r) {
    if (r === 0) return '$0';
    if (r >= 0.01) return '$' + r.toFixed(2);
    return '$' + r.toFixed(8).replace(/0+$/, '');
  }

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function meterOf(key) {
    for (var i = 0; i < METERS.length; i++) if (METERS[i].key === key) return METERS[i];
    return null;
  }

  function planOf(id) {
    for (var i = 0; i < PLANS.length; i++) if (PLANS[i].id === id) return PLANS[i];
    return PLANS[1];
  }

  function allowanceOf(key) {
    var tiers = TIERS[key];
    return tiers && tiers[0].rate === 0 && tiers[0].upTo !== null ? tiers[0].upTo : 0;
  }

  /* ---------- math: graduated tiers, never a flat rate on the whole quantity ---------- */

  function costFor(key, qty) {
    var tiers = TIERS[key] || [];
    var total = 0;
    var bands = [];
    var floor = 0;
    for (var i = 0; i < tiers.length; i++) {
      var cap = tiers[i].upTo === null ? Infinity : tiers[i].upTo;
      var units = Math.min(qty, cap) - floor;
      if (units > 0) {
        var amount = units * tiers[i].rate;
        total += amount;
        bands.push({ from: floor, to: cap, units: units, rate: tiers[i].rate, amount: amount });
      }
      floor = cap;
      if (qty <= cap) break;
    }
    return { total: total, bands: bands };
  }

  /* ---------- slider: log scale so the low end of a 200M meter stays usable ---------- */

  function snap(v, max) {
    v = Math.round(v);
    if (v <= 1000) return Math.min(v, max);
    var factor = Math.pow(10, Math.max(0, String(v).length - 3));
    return Math.min(Math.round(v / factor) * factor, max);
  }

  function posToVal(pos, max) {
    if (pos <= 0) return 0;
    if (pos >= 1000) return max;
    return snap(Math.pow(max + 1, pos / 1000) - 1, max);
  }

  function valToPos(val, max) {
    if (val <= 0) return 0;
    if (val >= max) return 1000;
    return Math.round((1000 * Math.log(val + 1)) / Math.log(max + 1));
  }

  function parseNum(raw) {
    var n = parseFloat(String(raw).replace(/[^0-9.\-]/g, ''));
    if (!isFinite(n) || n < 0) return 0;
    return Math.round(n);
  }

  /* ---------- state ---------- */

  function currentPlan() {
    var checked = root.querySelector('input[name="' + pid + '-plan"]:checked');
    return planOf(checked ? checked.value : root.getAttribute('data-plan'));
  }

  function currentInterval() {
    var checked = root.querySelector('input[name="' + pid + '-interval"]:checked');
    return checked ? checked.value : 'monthly';
  }

  /* ---------- render ---------- */

  function bandLine(m, b) {
    var range = b.to === Infinity ? 'above ' + fmtInt(b.from) : fmtInt(b.from) + ' to ' + fmtInt(b.to);
    return (
      '<li class="pcalc-band">' +
      '<span class="pcalc-band-range">' + esc(range) + '</span>' +
      '<span class="pcalc-band-calc">' + fmtInt(b.units) + ' ' + esc(m.unit) + ' &times; ' +
      fmtRate(b.rate) + ' = ' + fmtMoney(b.amount) + '</span>' +
      '</li>'
    );
  }

  function render() {
    var plan = currentPlan();
    var interval = plan.monthly === 0 ? 'monthly' : currentInterval();
    var hardCap = plan.hardCap === true;

    var html = '';
    var subtotal = 0;
    var anyBlocked = false;

    METERS.forEach(function (m) {
      var qty = values[m.key];
      var allow = allowanceOf(m.key);
      var billable = Math.max(qty - allow, 0);
      var result = costFor(m.key, qty);
      var blocked = hardCap && billable > 0;
      var bands = blocked ? result.bands.filter(function (b) { return b.rate === 0; }) : result.bands;

      var costCell;
      if (blocked) {
        anyBlocked = true;
        costCell = '<span class="pcalc-blocked">Blocked on Free</span>';
      } else {
        subtotal += result.total;
        costCell = fmtMoney(result.total);
      }

      var open = expanded[m.key] === true;
      html +=
        '<tr class="pcalc-row">' +
        '<td>' +
        '<button type="button" class="pcalc-expand" data-key="' + m.key + '" aria-expanded="' + (open ? 'true' : 'false') + '">' +
        '<span class="pcalc-caret" aria-hidden="true">' + (open ? '&#9662;' : '&#9656;') + '</span>' +
        esc(m.label) +
        '</button>' +
        '</td>' +
        '<td class="pcalc-right pcalc-mono">' + fmtInt(qty) + '</td>' +
        '<td class="pcalc-right pcalc-mono pcalc-dim">' + fmtInt(allow) + '</td>' +
        '<td class="pcalc-right pcalc-mono">' + fmtInt(billable) + '</td>' +
        '<td class="pcalc-right pcalc-mono pcalc-cost">' + costCell + '</td>' +
        '</tr>';

      html +=
        '<tr class="pcalc-bands-row"' + (open ? '' : ' hidden') + '>' +
        '<td colspan="5"><ul class="pcalc-bands">' +
        bands.map(function (b) { return bandLine(m, b); }).join('') +
        '</ul></td>' +
        '</tr>';
    });

    rowsEl.innerHTML = html;
    if (noteEl) noteEl.hidden = !anyBlocked;

    /* Totals. Meter costs are summed unrounded and rounded once for display. */
    var monthlyFee = interval === 'annual' ? plan.annual / 12 : plan.monthly;
    var totalsHtml =
      '<div class="pcalc-total-line">' +
      '<span>Usage subtotal</span><span class="pcalc-mono">' + fmtMoney(subtotal) + '</span>' +
      '</div>';

    if (interval === 'annual' && plan.annual > 0) {
      var discount = Math.round((1 - plan.annual / (plan.monthly * 12)) * 100);
      totalsHtml +=
        '<div class="pcalc-total-line">' +
        '<span>Platform fee' +
        '<span class="pcalc-sub">' + fmtMoney(plan.annual / 12) + ' per month effective, ' + discount + '% off monthly</span>' +
        '</span>' +
        '<span class="pcalc-mono">' + fmtMoney(plan.annual) + ' / year</span>' +
        '</div>';
    } else {
      totalsHtml +=
        '<div class="pcalc-total-line">' +
        '<span>Platform fee</span>' +
        '<span class="pcalc-mono">' + fmtMoney(plan.monthly) + ' / month</span>' +
        '</div>';
    }

    totalsHtml +=
      '<div class="pcalc-total-line pcalc-grand">' +
      '<span>Estimated monthly total</span>' +
      '<span class="pcalc-mono">' + fmtMoney(subtotal + monthlyFee) + '</span>' +
      '</div>';

    if (interval === 'annual' && plan.annual > 0) {
      totalsHtml +=
        '<div class="pcalc-total-line">' +
        '<span>Estimated annual total<span class="pcalc-sub">same usage every month</span></span>' +
        '<span class="pcalc-mono">' + fmtMoney(subtotal * 12 + plan.annual) + '</span>' +
        '</div>';
    }

    totalsEl.innerHTML = totalsHtml;

    /* The interval only moves the platform fee, so it is dead on the $0 plans. */
    var feeless = plan.monthly === 0;
    root.querySelectorAll('input[name="' + pid + '-interval"]').forEach(function (el) {
      el.disabled = feeless;
    });
    if (intervalSet) intervalSet.classList.toggle('pcalc-disabled', feeless);
    if (intervalHint) {
      intervalHint.textContent = feeless ? 'No platform fee on ' + plan.label + ', so the interval changes nothing' : '';
    }
  }

  /* ---------- wiring ---------- */

  METERS.forEach(function (m) {
    var num = root.querySelector('input[data-meter="' + m.key + '"]');
    var range = root.querySelector('input[data-range="' + m.key + '"]');
    if (!num || !range) return;

    range.value = String(valToPos(m.def, m.max));

    num.addEventListener('input', function () {
      values[m.key] = parseNum(num.value);
      range.value = String(valToPos(values[m.key], m.max));
      render();
    });

    num.addEventListener('blur', function () {
      num.value = fmtInt(values[m.key]);
    });

    range.addEventListener('input', function () {
      values[m.key] = posToVal(parseInt(range.value, 10), m.max);
      num.value = fmtInt(values[m.key]);
      render();
    });
  });

  root.querySelectorAll('input[name="' + pid + '-plan"], input[name="' + pid + '-interval"]').forEach(function (el) {
    el.addEventListener('change', render);
  });

  rowsEl.addEventListener('click', function (ev) {
    var btn = ev.target.closest ? ev.target.closest('.pcalc-expand') : null;
    if (!btn) return;
    var key = btn.getAttribute('data-key');
    expanded[key] = expanded[key] !== true;
    render();
  });

  render();
})();
</script>

<style is:inline>
  .pcalc {
    margin: 24px 0;
    border: 1px solid var(--color-border-default);
    border-radius: 10px;
    background: var(--color-bg-secondary);
    overflow: hidden;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  /* Controls */
  .pcalc-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    padding: 16px;
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-bg-tertiary);
  }
  .pcalc-fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .pcalc-legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .pcalc-segments {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 3px;
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    background: var(--color-bg-primary);
  }
  .pcalc-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .pcalc-segment {
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--color-text-tertiary);
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pcalc-segment:hover { background: var(--color-bg-hover); color: var(--color-text-secondary); }
  .pcalc-radio:checked + .pcalc-segment {
    background: var(--color-bg-hover);
    color: var(--color-text-primary);
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--color-border-accent);
  }
  .pcalc-radio:focus-visible + .pcalc-segment {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 1px;
  }
  .pcalc-disabled .pcalc-segments { opacity: 0.45; }
  .pcalc-disabled .pcalc-segment { cursor: not-allowed; }
  .pcalc-hint {
    margin: 6px 0 0;
    font-size: 11.5px;
    color: var(--color-text-muted);
  }
  .pcalc-hint:empty { display: none; }

  /* Meters */
  .pcalc-meters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
    padding: 18px 16px;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .pcalc-meter { min-width: 0; }
  .pcalc-meter-label {
    display: block;
    margin-bottom: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .pcalc-meter-input {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border: 1px solid var(--color-border-default);
    border-radius: 6px;
    background: var(--color-bg-primary);
  }
  .pcalc-meter-input:focus-within { border-color: var(--color-border-bright); }
  .pcalc-num {
    flex: 1 1 auto;
    min-width: 0;
    padding: 7px 0;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    outline: none;
  }
  .pcalc-unit {
    flex: 0 0 auto;
    font-size: 11.5px;
    color: var(--color-text-muted);
  }
  .pcalc-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    margin: 12px 0 6px;
    border-radius: 2px;
    background: var(--color-border-default);
    cursor: pointer;
  }
  .pcalc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border-bright);
    background: var(--color-accent-primary);
  }
  .pcalc-range::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid var(--color-border-bright);
    background: var(--color-accent-primary);
  }
  .pcalc-range:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 3px;
  }
  .pcalc-meter-foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .pcalc-meter-max { white-space: nowrap; }

  /* Results table */
  .pcalc-table-wrap {
    overflow-x: auto;
    padding: 0 16px;
  }
  .pcalc-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    margin: 0;
    font-size: 12.5px;
  }
  .pcalc-table th {
    padding: 12px 10px;
    border-bottom: 1px solid var(--color-border-default);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: left;
    white-space: nowrap;
  }
  .pcalc-table td {
    padding: 9px 10px;
    border-bottom: 1px solid var(--color-border-subtle);
    vertical-align: top;
  }
  .pcalc-table .pcalc-right { text-align: right; }
  .pcalc-mono { font-family: var(--font-mono); }
  .pcalc-dim { color: var(--color-text-muted); }
  .pcalc-cost { color: var(--color-text-primary); font-weight: 600; }
  .pcalc-expand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    font: inherit;
    font-weight: 600;
    text-align: left;
