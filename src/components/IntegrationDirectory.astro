---
import { integrationCategories, integrations, integrationAids, integrationSearchText, integrationsInCategory } from '../lib/integrations.mjs';
import manifest from '../../public/images/integrations/manifest.json';
const assets = manifest.assets as Record<string, {kind: string; file?: string; text?: string; tile?: string}>;
// Published fragment links predate the catalog's category names.
const legacyFragments: Record<string, string> = { providers: 'llm-models', frameworks: 'orchestration-frameworks', apps: 'other', import: 'import-traces', export: 'export--alerts' };
---
<section data-integration-directory aria-label="Integration guides">
  <h2 class="directory-sr-only">About</h2>
  <div class="directory-controls" hidden>
    <label class="directory-search-label" for="integration-search">Find an integration</label>
    <div class="directory-search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
      <input id="integration-search" type="search" placeholder="Search integrations or tools" autocomplete="off" />
    </div>
    <div class="directory-category-select">
      <label for="integration-category">Category</label>
      <select id="integration-category">
        <option value="all">All categories</option>
        {integrationCategories.map(category => <option value={category.id}>{category.name}</option>)}
      </select>
    </div>
    <div class="directory-filters" role="group" aria-label="Filter by category">
      <button type="button" data-category="all" aria-pressed="true">All</button>
      {integrationCategories.map(category => <button type="button" data-category={category.id} aria-pressed="false">{category.name}</button>)}
    </div>
  </div>
  <noscript><p class="directory-noscript">Browse by category: {integrationCategories.map((category, index) => <>{index > 0 && ' · '}<a href={`#${category.id}`}>{category.name}</a></>)}</p></noscript>
  <div class="directory-results">
    <p data-result-count role="status" aria-live="polite" aria-atomic="true">{integrations.length} integrations</p>
    <button type="button" class="directory-clear" data-clear hidden>Clear filters</button>
  </div>
  <div class="directory-empty" data-empty hidden>
    <h2>No integrations found</h2>
    <p>Try another name or connection method, or clear your filters.</p>
    <button type="button" class="directory-clear" data-clear>Clear filters</button>
  </div>
  {integrationCategories.map(category => (
    <section class="directory-group" data-group={category.id} aria-labelledby={category.id}>
      {legacyFragments[category.id] && <span id={legacyFragments[category.id]} class="directory-legacy-anchor" aria-hidden="true" />}
      <div class="directory-group-heading"><h2 id={category.id}>{category.name}</h2><p>{category.description}</p></div>
      <div class="directory-grid">
        {integrationsInCategory(category.id).map(entry => {
          const asset = assets[entry.logo];
          return <a class="integration-card" href={entry.href} data-integration-card data-category={entry.category} data-search={integrationSearchText(entry)}>
            <div class="integration-card-heading">
              <span class:list={['integration-logo', asset.kind !== 'brand' && 'integration-logo-fallback', asset.tile === 'dark' && 'integration-logo-dark']} aria-hidden="true">
                {asset.file ? <img src={asset.file} width="40" height="40" alt="" loading="lazy" decoding="async" /> : <span>{asset.text}</span>}
              </span>
              <h3>{entry.name}</h3>
              <span class="integration-arrow" aria-hidden="true">→</span>
            </div>
            <p>{entry.summary}</p>
            <span class="integration-method">{entry.method}</span>
          </a>;
        })}
      </div>
    </section>
  ))}
  <div class="directory-setup" id="traceai"><span>Getting started?</span> {integrationAids.map(a => <a href={a.href}>{a.name}<span aria-hidden="true"> →</span></a>)}</div>
</section>
<script is:inline>
(function () {
  function initDirectory() {
    var root = document.querySelector('[data-integration-directory]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    var input = root.querySelector('input');
    var buttons = Array.from(root.querySelectorAll('[data-category]:not([data-integration-card])'));
    var cards = Array.from(root.querySelectorAll('[data-integration-card]'));
    var timer;
    var directoryPath = location.pathname;
    function apply() {
      var params = new URLSearchParams(location.search);
      var q = params.get('q') || '';
      var category = params.get('category') || 'all';
      if (!buttons.some(function(b) { return b.dataset.category === category; })) category = 'all';
      input.value = q;
      root.querySelector('select').value = category;
      var terms = q.trim().toLocaleLowerCase('en').split(/\s+/).filter(Boolean);
      var count = 0;
      cards.forEach(function(card) {
        card.hidden = (category !== 'all' && card.dataset.category !== category) || !terms.every(function(t) { return card.dataset.search.includes(t); });
        if (!card.hidden) count++;
      });
      root.querySelectorAll('[data-group]').forEach(function(group) { group.hidden = !Array.from(group.querySelectorAll('[data-integration-card]')).some(function(c) { return !c.hidden; }); });
      buttons.forEach(function(b) { b.setAttribute('aria-pressed', String(b.dataset.category === category)); });
      root.querySelector('[data-result-count]').textContent = count + (count === 1 ? ' integration' : ' integrations');
      root.querySelector('[data-empty]').hidden = count !== 0;
      root.querySelector('.directory-results [data-clear]').hidden = !q && category === 'all';
    }
    function update(q, category) {
      clearTimeout(timer);
      // FastNav pushes the guide URL before an uncached fetch replaces this
      // still-connected directory. Never write directory state into that URL.
      if (!root.isConnected || location.pathname !== directoryPath) return;
      var url = new URL(location.href);
      if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
      if (category && category !== 'all') url.searchParams.set('category', category); else url.searchParams.delete('category');
      if (url.href !== location.href) history.pushState(history.state, '', url);
      apply();
    }
    input.addEventListener('input', function() {
      clearTimeout(timer);
      var value = input.value;
      timer = setTimeout(function() { if (root.isConnected) update(value, new URLSearchParams(location.search).get('category')); }, 180);
    });
    root.querySelector('select').addEventListener('change', function(e) { update(input.value, e.target.value); });
    buttons.forEach(function(b) { b.addEventListener('click', function() { update(input.value, b.dataset.category); }); });
    root.querySelectorAll('[data-clear]').forEach(function(b) { b.addEventListener('click', function() { update('', 'all'); input.focus(); }); });
    root._integrationApply = apply;
    root.querySelector('.directory-controls').hidden = false;
    apply();
  }
  initDirectory();
  if (!window.__integrationDirectoryReady) {
    window.__integrationDirectoryReady = true;
    document.addEventListener('astro:page-load', initDirectory);
    window.addEventListener('fastnav', initDirectory);
    window.addEventListener('popstate', function() {
      var root = document.querySelector('[data-integration-directory]');
      if (root && root._integrationApply) root._integrationApply();
    });
  }
})();
</script>
